# Бот Telegram на сервере chat-engine.
# На проде этот блок целиком кладётся в секрет GitHub ENV_FILE. deploy/update.sh пишет из него .env.
TELEGRAM_BOT_TOKEN=123456:ABC...
CHAT_API_URL=https://api.chatwithyou.site
CHAT_API_TG_TOKEN=change-me-min-16-chars
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
# TG_BOT_IMAGE=username/dating-tg-bot:sha

# Локальный запуск без Chat API: REST и события подменяются заглушкой.
# На проде оставьте DEV=false или не задавайте вовсе.
DEV=false
# Задержка поиска собеседника и ответа заглушки, секунды.
DEV_PARTNER_DELAY=2
DEV_REPLY_DELAY=1.5
# true — собеседник-заглушка повторяет присланный текст.
DEV_ECHO=true
